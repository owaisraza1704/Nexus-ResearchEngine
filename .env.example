NEXUS_ENVIRONMENT=development
NEXUS_DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
NEXUS_ARTIFACT_STORE_PATH=.data/artifacts
NEXUS_MAX_UPLOAD_BYTES=20971520
NEXUS_MAX_DOCUMENT_PAGES=100
NEXUS_MAX_DOCUMENT_CHARS=500000
NEXUS_MAX_DOCUMENT_CHUNKS=1000
NEXUS_MAX_CHUNK_CHARS=16000
NEXUS_MAX_QUESTION_CHARS=4000
NEXUS_MAX_TOP_K=20
NEXUS_MAX_CONTEXT_CHARS=24000
NEXUS_MAX_ANSWER_CHARS=12000
NEXUS_MAX_ANSWER_TOKENS=2000
NEXUS_PROVIDER_TIMEOUT_SECONDS=45
NEXUS_ANSWER_TIMEOUT_SECONDS=90
NEXUS_INGESTION_TIMEOUT_SECONDS=180
NEXUS_MAX_RESEARCH_SOURCES=5
NEXUS_MAX_RESEARCH_CONTEXT_CHARS=48000
NEXUS_MAX_RESEARCH_EVIDENCE=20
NEXUS_MAX_RESEARCH_CLAIMS=12
NEXUS_MAX_RESEARCH_OUTPUT_CHARS=24000
NEXUS_MAX_RESEARCH_OUTPUT_TOKENS=6000
NEXUS_RESEARCH_TIMEOUT_SECONDS=120
# Local asynchronous research defaults. A job may request lower limits, not higher ones.
NEXUS_WORKER_CONCURRENCY=2
# Redis is a Celery message broker only; prompt/response caching is not implemented.
NEXUS_CELERY_BROKER_URL=redis://localhost:6379/0
NEXUS_CELERY_QUEUE=nexus
NEXUS_MAX_JOB_TASKS=12
NEXUS_MAX_JOB_DEPTH=6
NEXUS_MAX_JOB_PARALLEL_TASKS=2
NEXUS_MAX_JOB_PROVIDER_CALLS=20
NEXUS_MAX_JOB_INPUT_TOKENS=100000
NEXUS_MAX_JOB_OUTPUT_TOKENS=20000
NEXUS_JOB_TIMEOUT_SECONDS=600
NEXUS_MAX_WEB_SOURCES=3
NEXUS_MAX_WEB_BYTES=2097152
NEXUS_WEB_TIMEOUT_SECONDS=20
NEXUS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
NEXUS_AZURE_OPENAI_API_KEY=replace-with-azure-openai-key
NEXUS_AZURE_OPENAI_API_VERSION=2024-10-21
NEXUS_AZURE_OPENAI_MODEL=your-chat-model-deployment
NEXUS_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-text-embedding-3-large-deployment
NEXUS_AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072
